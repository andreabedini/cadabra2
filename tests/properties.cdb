
def test01():
    __cdbkernel__=create_scope()
    try:
        {c,d}::Coordinate;
        {a,b,c,d}::Indices;
        assert(1==0)
    except RuntimeError as e:
        print("Test 01 passed")

test01()

def test02():
    __cdbkernel__=create_scope()
    try:
        {a,b,c,d}::Indices;
        {c,d}::Coordinate;
        assert(1==0)
    except RuntimeError as e:
        print("Test 02 passed")

test02()

def test03():
    __cdbkernel__=create_scope()
    # Redeclaring a property replaces it in the kernel; a Python object
    # holding the old one must keep it alive (this used to read freed
    # memory).
    p = Symmetric(Ex(r'A_{m n}'))
    q = Symmetric(Ex(r'A_{m n}'))
    assert(str(p)==str(q))
    assert(Symmetric.get(Ex(r'A_{m n}')) is not None)
    print("Test 03 passed")

test03()
